generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  login    String @unique
  email    String @unique
  password String
  phone    String
  imgLink  String?

  name    String
  surname String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
